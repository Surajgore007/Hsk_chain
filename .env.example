# Fathom — environment variables (NEVER commit the real .env)
# Copy this to .env and fill in the values.

# ─── Networks ────────────────────────────────────────────────────────────────
RPC_TESTNET=https://testnet.hsk.xyz
RPC_MAINNET_READONLY=https://mainnet.hsk.xyz
CHAIN_ID=133

# ─── Wallets (burner keys; testnet funds only; never commit real keys) ────────
OWNER_PK=0xYOUR_OWNER_PRIVATE_KEY
OPERATOR_PK=0xYOUR_OPERATOR_PRIVATE_KEY
MOVER_PK=0xYOUR_MOVER_PRIVATE_KEY

# ─── LLM (choose one) ────────────────────────────────────────────────────────
LLM_PROVIDER=groq               # groq | gemini
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-1.5-flash

# ─── Agent behaviour ─────────────────────────────────────────────────────────
DEMO_MODE=true
POLL_SECONDS=20
AUTO_CONFIRM=false
RECORD_REFUSALS_ONCHAIN=auto   # auto | always | never

# ─── Filled in by scripts/setup-testnet after deployment ─────────────────────
EXECUTION_GUARD_ADDRESS=
MOCK_USDT_ADDRESS=
WHSK_ADDRESS=0xCA8aAceEC5Db1e91B9Ed3a344bA026c4a2B3ebF6
POOL_ADDRESS=
QUOTER_ADDRESS=
ROUTER_ADDRESS=0xa6914E66690c6794244B5f66a09eAEbf66254237
FACTORY_ADDRESS=
POSITION_MANAGER_ADDRESS=
MAINNET_POOL_ADDRESS=0x4ff515761864e7838b0adb8b5b2b8b7a068905dc

