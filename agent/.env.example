# ─── Fathom Environment Variables (NEVER commit real private keys) ───────────
#
# Production Deployment Environment Variables:
# Backend (Render Web Service):
#   - RPC_TESTNET
#   - RPC_MAINNET_READONLY
#   - CHAIN_ID
#   - OPERATOR_PK
#   - MOVER_PK
#   - GROQ_API_KEY
#   - ADMIN_TOKEN
#   - ALLOWED_ORIGIN
#
# Frontend (Vercel):
#   - VITE_API_URL

# ─── Network RPCs ─────────────────────────────────────────────────────────────
RPC_TESTNET=https://testnet.hsk.xyz
RPC_MAINNET_READONLY=https://mainnet.hsk.xyz
CHAIN_ID=133

# ─── Wallets (Burner keys on HSK Testnet; never commit real keys) ────────────
OPERATOR_PK=0xYOUR_OPERATOR_PRIVATE_KEY
MOVER_PK=0xYOUR_MOVER_PRIVATE_KEY
# OWNER_PK is optional (only needed if owner wants to unpause contract via API)
# OWNER_PK=0xYOUR_OWNER_PRIVATE_KEY

# ─── AI / LLM Intent Parser ──────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Production Security & CORS ──────────────────────────────────────────────
# Protects /api/demo/mover from unauthorized triggers
ADMIN_TOKEN=your_secure_random_admin_token_here

# Allowed frontend origin for CORS (e.g. https://your-fathom-frontend.vercel.app or *)
ALLOWED_ORIGIN=https://your-fathom-app.vercel.app

# ─── Agent Autonomous Loop & Safety ──────────────────────────────────────────
DEMO_MODE=true
POLL_SECONDS=20
RECORD_REFUSALS_ONCHAIN=auto
PORT=3001
